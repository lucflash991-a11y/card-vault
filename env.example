GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Paste your Firebase Web App config as ONE line of JSON.
# This config is client configuration, not an admin/service-account key.
FIREBASE_WEB_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}

# Set true only after Apple provider is fully configured in Firebase + Apple Developer.
APPLE_AUTH_ENABLED=false

PORT=3000
